# ==========================================================================
# .env.example -- copy to .env and fill in.
#
#   cp .env.example .env
#
# .env is git-ignored and must NEVER be committed. Credentials are read from
# the environment only: they appear in no source file, and the logging filter
# in core/logging_setup.py replaces the values of TOWBOOK_PASS,
# ANTHROPIC_API_KEY, TWILIO_AUTH_TOKEN and SMTP_PASS with ***REDACTED***
# wherever they turn up in a log record.
#
# Anything already exported in the real environment wins over this file.
#
# ON RAILWAY THERE IS NO .env FILE. Set these in the service's Variables tab.
# The ones you MUST set there are marked [RAILWAY] below; everything else has a
# working default. Copy-paste block for a new Railway service:
#
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#   TZ=America/Detroit
#   TOWBOOK_USER=...
#   TOWBOOK_PASS=...
#   DASHBOARD_PASSWORD=1234
#   SESSION_SECRET=<64 random hex characters>
#   RUN_SCHEDULER=true
#   ANTHROPIC_API_KEY=...        (optional; without it the Analyst is skipped)
# ==========================================================================

# --------------------------------------------------------------------------
# Towbook portal
# --------------------------------------------------------------------------
TOWBOOK_USER=
TOWBOOK_PASS=
TOWBOOK_BASE_URL=https://app.towbook.com

# --------------------------------------------------------------------------
# Multiple towing companies
# --------------------------------------------------------------------------
# config/companies.yaml is the roster. It is committed to git and therefore
# holds only the NAME of the variable prefix, never a login:
#
#     companies:
#       - id: acme-towing
#         credentials_env: ACME     ->  TOWBOOK_ACME_USER / TOWBOOK_ACME_PASS
#
# Set one pair per company here (or on the Railway service):
#   TOWBOOK_ACME_USER=
#   TOWBOOK_ACME_PASS=
#
# A company that declares a prefix NEVER falls back to TOWBOOK_USER /
# TOWBOOK_PASS when its own variables are missing -- falling back would sign in
# as a DIFFERENT company and file its jobs under this one. It is an error that
# names the missing variable.
#
# A company entry with no credentials_env uses the plain TOWBOOK_USER /
# TOWBOOK_PASS above, which is what an existing single-company install already
# has. Delete config/companies.yaml entirely and nothing changes.
#
# Every TOWBOOK_*_PASS is scrubbed from log records, the same as TOWBOOK_PASS.

# Legacy. Superseded by config/companies.yaml; still honoured for installs that
# already used it. A JSON list of {"account_id","user","pass"}.
#   TOWBOOK_ACCOUNTS=[{"account_id":"main","user":"...","pass":"..."}]
TOWBOOK_ACCOUNTS=

# --------------------------------------------------------------------------
# Locale and storage
# --------------------------------------------------------------------------
# [RAILWAY] Local timezone for report windows, the dashboard and message
# bodies. Storage is always UTC. A container defaults to UTC, so leaving this
# unset on Railway silently moves every "day" boundary four or five hours and
# puts the wrong offers in the wrong day.
#
# PER COMPANY: an entry in config/companies.yaml may name its own `timezone:`,
# and that wins for that company. A Texas tenant and an Ohio tenant reporting
# out of one install do not share a clock, and a coverage window read in the
# wrong one is a claim about a shift nobody works. TZ is the fallback, and is
# what a single-company install uses.
TZ=America/Detroit

# [RAILWAY] SQLite by default, for local development and the test suite only.
# A relative path is resolved against the repo root, not the current working
# directory.
#
#   *** SQLITE MUST NOT BE USED ON RAILWAY. ***
#
# A Railway container's filesystem is EPHEMERAL: it is recreated from the image
# on every redeploy, every restart and every crash. data/towbook.db is inside
# it, so the entire history -- every offer, every metric, every run record --
# is deleted without an error the next time anybody pushes a commit. Nothing
# fails; the board simply shows an empty month. Add a PostgreSQL database to
# the Railway project and reference it:
#
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#
# `postgres://` and bare `postgresql://` are both accepted -- core/db.py
# rewrites them to `postgresql+psycopg://`, so the value Railway gives you works
# unedited. The app logs CRITICAL and puts a red banner on every tab if it finds
# itself running on SQLite inside a container.
DATABASE_URL=sqlite:///data/towbook.db

# Optional. Which PostgreSQL driver to use. Default `psycopg` (psycopg 3), which
# is what requirements.txt installs. Set to psycopg2 only if you have swapped
# the dependency.
POSTGRES_DRIVER=

# Optional connection-pool tuning, PostgreSQL only. The defaults suit one small
# web process on a hosted database with a low connection cap. Raise pool size
# only if /health shows pool timeouts.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# --------------------------------------------------------------------------
# Dashboard access. The whole board is behind one shared password.
# --------------------------------------------------------------------------
# [RAILWAY] The password. Default 1234 if unset, which is what was asked for
# and is NOT adequate for real customer data -- still less for several towing
# companies' data behind one login. Change it before the URL is shared with
# anyone. The login page says so while the default is still in place.
DASHBOARD_PASSWORD=1234

# [RAILWAY] Signs the session cookie. Leave it unset and a random one is
# generated per process, which means every redeploy (and every restart) logs
# everybody out. Set it to 64 random hex characters and keep it secret:
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# How long a login lasts. Default 30 days.
DASHBOARD_SESSION_DAYS=30

# --------------------------------------------------------------------------
# Analyst -- the single LLM component in the system
# --------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --------------------------------------------------------------------------
# SMS (Twilio)
#
# NOTHING IS SENT BY DEFAULT. config/notifications.yaml ships with every route
# carrying `enabled: false`, because the dashboard is the delivery mechanism.
# These are only needed if you switch an SMS route back on in that file -- and
# if you do, a failed pipeline run will then reach you two ways, which is fine.
# --------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sending number in E.164 format, e.g. +13135550100
TWILIO_FROM=

# --------------------------------------------------------------------------
# Email (SMTP). Also disabled by default -- see the note above Twilio.
# --------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --------------------------------------------------------------------------
# Recipients. config/notifications.yaml refers to these by NAME, never by
# value, which is what keeps real phone numbers out of version control.
# Phones in E.164 format.
# --------------------------------------------------------------------------
OWNER_PHONE=
OWNER_EMAIL=
OPS_MANAGER_PHONE=
OPS_MANAGER_EMAIL=

# --------------------------------------------------------------------------
# Browser automation (the `--source ui` fallback path ONLY)
#
# NOT NEEDED ON RAILWAY. The default acquisition path is `source: api`: plain
# HTTP to Towbook's JSON endpoint, no browser, and no playwright import at
# module scope anywhere on that path. Playwright is not in requirements.txt and
# the container has no browsers. Everything in this section applies only if you
# set `source: ui` in config/schedule.yaml, which additionally needs the
# Playwright buildpack -- see nixpacks.toml.
# --------------------------------------------------------------------------
# true in production. Set false to watch the browser drive Towbook, which is
# how you reconcile config/selectors.yaml after a portal change.
HEADLESS=true
# Milliseconds of delay between Playwright actions. 0 in production; 250-500
# makes a debugging session followable.
PLAYWRIGHT_SLOWMO=0

# --------------------------------------------------------------------------
# Acquisition tuning. Every one of these is optional -- the defaults shown are
# what the agent uses when the variable is unset.
# --------------------------------------------------------------------------
# chromium | firefox | webkit
TOWBOOK_BROWSER=chromium
# Page navigation timeout.
TOWBOOK_NAV_TIMEOUT_MS=45000
# Hard wall-clock budget for a single stage (login, filters, export, ...).
TOWBOOK_STAGE_TIMEOUT_MS=90000
# How long to wait on any ONE selector candidate before trying the next.
TOWBOOK_SELECTOR_PROBE_MS=3000
# How long to wait for the export file after clicking Export.
TOWBOOK_DOWNLOAD_TIMEOUT_MS=180000
# Backoff between acquisition attempts, comma separated seconds. Three values
# means three retries after the first try. Set to 0 in tests.
TOWBOOK_RETRY_BACKOFF_S=30,120,300
# How long `bootstrap-session` waits for a human to finish logging in.
TOWBOOK_BOOTSTRAP_TIMEOUT_S=900
# true = abort when the page-size control cannot be found. Default false: the
# export is not page-size dependent on every portal, so this only warns.
TOWBOOK_REQUIRE_PAGE_SIZE=false
# true (default) = abort when the date range cannot be entered AND VERIFIED.
# Exporting the portal's default window would produce plausible but wrong
# numbers, which is worse than producing none. Only set false while
# reconciling selectors.
TOWBOOK_REQUIRE_DATE_RANGE=true

# --------------------------------------------------------------------------
# Runtime
# --------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Port. On Railway do NOT set this: the platform assigns PORT and the app reads
# PORT first, DASHBOARD_PORT second. This is the local default.
DASHBOARD_PORT=8080

# Bind address. Left unset, the app binds 127.0.0.1 locally and 0.0.0.0 when it
# detects a container host (RAILWAY_ENVIRONMENT and friends), which is what the
# platform's router needs. Only set this to override that.
DASHBOARD_HOST=

# --------------------------------------------------------------------------
# Scheduling
# --------------------------------------------------------------------------
# [RAILWAY] Whether THIS process runs the scheduled jobs. Default true.
#
# The board is the only delivery mechanism, so if nothing runs the pipeline the
# dashboard keeps rendering yesterday's numbers as though they were today's --
# silently. The web process therefore schedules by default: if the board is up,
# the data behind it is being refreshed.
#
# Set false only when you have moved the scheduler to its own service
# (`python -m towbook_agent schedule`, the `worker` process in the Procfile).
# Two processes with this unset is caught by a Postgres advisory lock, but do
# not rely on that -- see towbook_agent/core/leader.py.
RUN_SCHEDULER=true

# Optional. Namespaces the scheduler's advisory lock, so two independent
# deployments can share one PostgreSQL server without fighting over it.
LOCK_NAMESPACE=

# --------------------------------------------------------------------------
# First boot
# --------------------------------------------------------------------------
# On a database with no requests at all, start.py pulls the trailing window once
# so the first deploy shows real numbers instead of empty tabs. One acquisition
# for the whole window; each day's metrics are then computed from stored rows
# with no further network calls. It runs once and never again -- any request in
# the table skips it.
BOOTSTRAP_ON_EMPTY=true
BOOTSTRAP_DAYS=30

# --------------------------------------------------------------------------
# Diagnostics
# --------------------------------------------------------------------------
# Optional. Set to 1 to echo every SQL statement -- noisy, debugging only.
SQL_ECHO=0

# Optional. Overrides the detected repo root. Only needed when running from
# an installed wheel with config/ somewhere else.
TOWBOOK_REPO_ROOT=
