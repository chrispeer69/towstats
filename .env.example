# ==========================================================================
# .env.example -- copy to .env and fill in.
#
#   cp .env.example .env
#
# .env is git-ignored and must NEVER be committed. Credentials are read from
# the environment only: they appear in no source file, and the logging filter
# in core/logging_setup.py replaces the values of TOWBOOK_PASS,
# ANTHROPIC_API_KEY, TWILIO_AUTH_TOKEN and SMTP_PASS with ***REDACTED***
# wherever they turn up in a log record.
#
# Anything already exported in the real environment wins over this file.
# ==========================================================================

# --------------------------------------------------------------------------
# Towbook portal
# --------------------------------------------------------------------------
TOWBOOK_USER=
TOWBOOK_PASS=
TOWBOOK_BASE_URL=https://app.towbook.com

# Optional. Multi-account support: a JSON list of accounts. When unset, a
# single account with id "default" uses TOWBOOK_USER / TOWBOOK_PASS.
#   TOWBOOK_ACCOUNTS=[{"account_id":"main","user":"...","pass":"..."},{"account_id":"second","user":"...","pass":"..."}]
TOWBOOK_ACCOUNTS=

# --------------------------------------------------------------------------
# Locale and storage
# --------------------------------------------------------------------------
# Local timezone for report windows, the dashboard and message bodies.
# Storage is always UTC.
TZ=America/Detroit

# SQLite by default. A relative path is resolved against the repo root, not
# the current working directory.
DATABASE_URL=sqlite:///data/towbook.db

# --------------------------------------------------------------------------
# Analyst -- the single LLM component in the system
# --------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --------------------------------------------------------------------------
# SMS (Twilio)
# --------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sending number in E.164 format, e.g. +13135550100
TWILIO_FROM=

# --------------------------------------------------------------------------
# Email (SMTP)
# --------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --------------------------------------------------------------------------
# Recipients. config/notifications.yaml refers to these by NAME, never by
# value, which is what keeps real phone numbers out of version control.
# Phones in E.164 format.
# --------------------------------------------------------------------------
OWNER_PHONE=
OWNER_EMAIL=
OPS_MANAGER_PHONE=
OPS_MANAGER_EMAIL=

# --------------------------------------------------------------------------
# Browser automation
# --------------------------------------------------------------------------
# true in production. Set false to watch the browser drive Towbook, which is
# how you reconcile config/selectors.yaml after a portal change.
HEADLESS=true
# Milliseconds of delay between Playwright actions. 0 in production; 250-500
# makes a debugging session followable.
PLAYWRIGHT_SLOWMO=0

# --------------------------------------------------------------------------
# Acquisition tuning. Every one of these is optional -- the defaults shown are
# what the agent uses when the variable is unset.
# --------------------------------------------------------------------------
# chromium | firefox | webkit
TOWBOOK_BROWSER=chromium
# Page navigation timeout.
TOWBOOK_NAV_TIMEOUT_MS=45000
# Hard wall-clock budget for a single stage (login, filters, export, ...).
TOWBOOK_STAGE_TIMEOUT_MS=90000
# How long to wait on any ONE selector candidate before trying the next.
TOWBOOK_SELECTOR_PROBE_MS=3000
# How long to wait for the export file after clicking Export.
TOWBOOK_DOWNLOAD_TIMEOUT_MS=180000
# Backoff between acquisition attempts, comma separated seconds. Three values
# means three retries after the first try. Set to 0 in tests.
TOWBOOK_RETRY_BACKOFF_S=30,120,300
# How long `bootstrap-session` waits for a human to finish logging in.
TOWBOOK_BOOTSTRAP_TIMEOUT_S=900
# true = abort when the page-size control cannot be found. Default false: the
# export is not page-size dependent on every portal, so this only warns.
TOWBOOK_REQUIRE_PAGE_SIZE=false
# true (default) = abort when the date range cannot be entered AND VERIFIED.
# Exporting the portal's default window would produce plausible but wrong
# numbers, which is worse than producing none. Only set false while
# reconciling selectors.
TOWBOOK_REQUIRE_DATE_RANGE=true

# --------------------------------------------------------------------------
# Runtime
# --------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
DASHBOARD_PORT=8080

# Optional. Set to 1 to echo every SQL statement -- noisy, debugging only.
SQL_ECHO=0

# Optional. Overrides the detected repo root. Only needed when running from
# an installed wheel with config/ somewhere else.
TOWBOOK_REPO_ROOT=
